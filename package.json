{
  "name": "foco",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @foco/api --filter @foco/web dev",
    "dev:api": "pnpm --filter @foco/api dev",
    "dev:web": "pnpm --filter @foco/web dev",
    "dev:mobile": "pnpm --filter @foco/mobile start",
    "build": "pnpm --filter @foco/web --filter @foco/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @foco/api db:push"
  }
}
