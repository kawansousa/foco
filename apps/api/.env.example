# Porta da API
PORT=4000

# Banco SQLite (caminho relativo a apps/api; criado pelas migrations)
DATABASE_URL=file:./data/foco.db

# Segredo usado para assinar os tokens JWT (obrigatório em produção)
JWT_SECRET=troque-este-segredo-em-producao

# Origens permitidas (CORS), separadas por vírgula. Vazio = todas (dev).
CORS_ORIGINS=http://localhost:3000

# Rate limit por IP (requisições por minuto): rotas de login/cadastro e demais rotas
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PER_MIN=300
