# Porta da API
PORT=4000

# Caminho do banco SQLite (criado automaticamente)
DATABASE_URL=./data/foco.db

# Segredo usado para assinar os tokens (troque em produção!)
JWT_SECRET=troque-este-segredo-em-producao

# Origens permitidas (CORS), separadas por vírgula. Vazio = todas (dev).
CORS_ORIGINS=http://localhost:3000
