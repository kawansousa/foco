# Porta da API
PORT=4000

# Banco SQLite (caminho relativo a apps/api; criado pelas migrations)
DATABASE_URL=file:./data/foco.db

# Segredo usado para assinar os tokens JWT (obrigatório em produção)
JWT_SECRET=troque-este-segredo-em-producao

# Origens permitidas (CORS), separadas por vírgula. Vazio = todas (dev).
CORS_ORIGINS=http://localhost:3000

# Rate limit por IP, janela de 1 minuto:
#  - login + cadastro somam num único balde por IP (RATE_LIMIT_AUTH_PER_MIN)
#  - demais rotas: RATE_LIMIT_PER_MIN por IP e por rota
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PER_MIN=300

# Atrás de proxy reverso (nginx, Render, Fly...), configure para o rate limit
# enxergar o IP real do cliente: número de saltos (ex.: 1) ou "loopback".
# Vazio = desligado (API exposta direto).
TRUST_PROXY=
