{
  "name": "@foco/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && node --watch -r ./swc-register.cjs src/main.ts",
    "start": "prisma migrate deploy && node -r ./swc-register.cjs src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "node -r ./swc-register.cjs prisma/seed.ts"
  },
  "dependencies": {
    "@foco/shared": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.0",
    "better-sqlite3": "^12.0.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "typescript": "^5",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
